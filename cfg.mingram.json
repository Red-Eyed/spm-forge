{
  "preset": "ocr_multilingual",
  "num_threads": 16,
  "corpus": {
    "path": "data/raw-corpus"
  },
  "output": {
    "work_dir": "runs/mingram",
    "model_prefix": "tokenizer"
  },
  "balancing": {
    "enabled": false
  },
  "sentencepiece": {
    "model_type": "mingram",
    "vocab_size": 8192,
    "mingram": {
      "iterations": 2
    }
  }
}
