{
  "preset": "multilingual_bpe",
  "num_threads": 16,
  "corpus": {
    "path": "data/raw-corpus"
  },
  "output": {
    "work_dir": "runs/bpe",
    "model_prefix": "tokenizer"
  },
  "canonicalization": {
    "unicode_form": "nfc"
  },
  "balancing": {
    "enabled": true,
    "mode": "script_sample"
  },
  "sentencepiece": {
    "model_type": "bpe",
    "vocab_size": 8192,
    "character_coverage": 0.9995,
    "byte_fallback": true,
    "normalization_rule_name": "identity",
    "add_dummy_prefix": false,
    "remove_extra_whitespaces": false
  },
  "evaluation": {
    "test_fraction": 0.05,
    "split_seed": 42
  }
}
